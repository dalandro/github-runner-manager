[Unit]
Description=Managed GitHub Actions runner
After=network.target

[Service]
Type=simple
WorkingDirectory=@RUNNER_DIRECTORY@
ExecStart=@RUNNER_EXEC@
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=60
# Each choice, and what is left off and why: docs/runner-units.md#hardening.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=default.target
