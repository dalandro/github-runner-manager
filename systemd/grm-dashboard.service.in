# Template for running the dashboard as a systemd user unit. Build the
# release first (cd dashboard && mix deps.get --only prod &&
# MIX_ENV=prod mix release), replace @GRM_ROOT@ with the absolute path of
# this checkout, save the result as
# ~/.config/systemd/user/grm-dashboard.service, then:
#   systemctl --user daemon-reload && systemctl --user enable --now grm-dashboard
# See docs/dashboard.md. The dashboard listens on 127.0.0.1 only.
[Unit]
Description=github-runner-manager dashboard (loopback only)
After=network.target

[Service]
Type=exec
ExecStart=@GRM_ROOT@/bin/grm-dashboard
Restart=on-failure
RestartSec=10
Nice=10
# Uncomment when mix is not on the service manager's PATH (version managers):
#Environment=PATH=/path/to/elixir/bin:/path/to/erlang/bin:/usr/bin:/bin
# Uncomment both to answer to one more exact host name, for a private-network
# proxy on this machine, and to show the page there only to the listed
# identities (docs/remote-access.md). The listening address stays loopback.
#Environment=GRM_DASHBOARD_ALLOWED_HOSTS=<machine>.<tailnet>.ts.net
#Environment=GRM_DASHBOARD_VIEWERS=<login-name>
# Run the built release only: never fetch or compile at start.
Environment=GRM_DASHBOARD_RELEASE_ONLY=1
NoNewPrivileges=true
MemoryMax=512M
TasksMax=512

[Install]
WantedBy=default.target
