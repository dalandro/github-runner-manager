#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"
# Start the read-only web dashboard on 127.0.0.1. It needs Elixir; without it,
# `grm-status --watch` is the terminal view of the same state.
# --allow-host adds a name the page answers to, for a proxy on this machine
# that serves it on a private network (docs/remote-access.md). The listening
# address stays 127.0.0.1. An extra name needs at least one --viewer: a
# user, as the proxy names them in its identity header, who may see the page.
usage='usage: grm-dashboard [--demo] [--port N] [--allow-host NAME]... [--viewer IDENTITY]...'
demo=0 port=${GRM_DASHBOARD_PORT:-4290} allowed_hosts=${GRM_DASHBOARD_ALLOWED_HOSTS:-}
viewers=${GRM_DASHBOARD_VIEWERS:-}
while (($#)); do
  case $1 in
    --demo) demo=1; shift;;
    --port)
      (($# >= 2)) || usage_error 'grm-dashboard: missing value for --port'
      port=$2; shift 2;;
    --allow-host)
      (($# >= 2)) && [[ -n $2 ]] || usage_error 'grm-dashboard: missing value for --allow-host'
      allowed_hosts=${allowed_hosts:+$allowed_hosts,}$2; shift 2;;
    --viewer)
      (($# >= 2)) && [[ $2 =~ ^[[:graph:]]+$ && $2 != *,* ]] || usage_error 'grm-dashboard: --viewer takes one identity (no spaces or commas)'
      viewers=${viewers:+$viewers,}$2; shift 2;;
    *) usage_error "$usage";;
  esac
done
if ! is_uint "$port" || ((port < 1 || port > 65535)); then usage_error 'grm-dashboard: invalid port'; fi
# Exact names only; the dashboard applies the same rule and is the authority.
host_label='[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?'
if [[ -n $allowed_hosts && ! $allowed_hosts =~ ^$host_label([.]$host_label)*(,$host_label([.]$host_label)*)*$ ]]; then
  usage_error 'grm-dashboard: allowed hosts are plain host names (no scheme, port, path or wildcard)'
fi
# The dashboard applies the same rule at boot and is the authority.
if [[ -n $allowed_hosts && -z ${viewers//[[:space:],]/} ]]; then
  usage_error 'grm-dashboard: an allowed host needs at least one --viewer (or GRM_DASHBOARD_VIEWERS); see docs/remote-access.md'
fi
dashboard=${GRM_DASHBOARD_DIR:-$GRM_ROOT/dashboard}
export PORT=$port PHX_SERVER=true MIX_ENV=prod
export GRM_STATUS_COMMAND=${GRM_STATUS_COMMAND-$GRM_ROOT/bin/grm-status} GRM_DASHBOARD_SOURCE=command
export GRM_DASHBOARD_ALLOWED_HOSTS=$allowed_hosts GRM_DASHBOARD_VIEWERS=$viewers
if ((demo)); then GRM_DASHBOARD_SOURCE=demo; fi
if [[ ! -e $GRM_CONFIG ]]; then
  printf 'grm-dashboard: no config file at %s, so running on defaults; set GRM_CONFIG to point at one (or copy config.example.env to config.env).\n' "$GRM_CONFIG"
fi
release=$dashboard/_build/prod/rel/dashboard/bin/dashboard
if [[ -x $release ]]; then
  # A release built before the checkout was updated would run old code, which
  # may lack checks the new settings rely on (such as the viewer list).
  newer=$(cd "$dashboard" && find lib config assets priv mix.exs mix.lock -newer "$release" -print -quit 2> /dev/null || true)
  if [[ -n $newer ]]; then
    error "grm-dashboard: the release is older than $newer; rebuild it with: cd dashboard && MIX_ENV=prod mix release"
    exit 1
  fi
  exec "$release" start
fi
# The service form: run what was built, never fetch or compile at start.
if [[ ${GRM_DASHBOARD_RELEASE_ONLY:-0} == 1 ]]; then
  error "grm-dashboard: no release at $release; build one with: cd dashboard && MIX_ENV=prod mix release"
  exit 1
fi
if ! command -v mix > /dev/null; then
  error 'grm-dashboard: Elixir (mix) is not installed; use "grm-status --watch" for a terminal view'
  exit 1
fi
cd "$dashboard"
# First run only: fetch the Hex packages (network), then mix compiles them.
if [[ ! -d deps/phoenix ]]; then mix deps.get --only prod; fi
printf 'grm-dashboard: http://127.0.0.1:%s (loopback only; stop with Ctrl-C)\n' "$port"
if [[ -n $allowed_hosts ]]; then printf 'grm-dashboard: also answers to: %s\n' "$allowed_hosts"; fi
if [[ -n $viewers ]]; then printf 'grm-dashboard: viewers: %s\n' "$viewers"; fi
exec mix phx.server
