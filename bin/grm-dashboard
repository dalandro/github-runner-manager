#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"
# Start the read-only web dashboard on 127.0.0.1. It needs Elixir; without it,
# `grm-status --watch` is the terminal view of the same state.
demo=0 port=${GRM_DASHBOARD_PORT:-4290}
while (($#)); do
  case $1 in
    --demo) demo=1; shift;;
    --port)
      (($# >= 2)) || usage_error 'grm-dashboard: missing value for --port'
      port=$2; shift 2;;
    *) usage_error 'usage: grm-dashboard [--demo] [--port N]';;
  esac
done
if ! is_uint "$port" || ((port < 1 || port > 65535)); then usage_error 'grm-dashboard: invalid port'; fi
dashboard=${GRM_DASHBOARD_DIR:-$GRM_ROOT/dashboard}
export PORT=$port PHX_SERVER=true MIX_ENV=prod
export GRM_STATUS_COMMAND=$GRM_ROOT/bin/grm-status GRM_DASHBOARD_SOURCE=command
if ((demo)); then GRM_DASHBOARD_SOURCE=demo; fi
release=$dashboard/_build/prod/rel/dashboard/bin/dashboard
if [[ -x $release ]]; then exec "$release" start; fi
if ! command -v mix > /dev/null; then
  error 'grm-dashboard: Elixir (mix) is not installed; use "grm-status --watch" for a terminal view'
  exit 1
fi
cd "$dashboard"
# First run only: fetch the Hex packages (network), then mix compiles them.
if [[ ! -d deps/phoenix ]]; then mix deps.get --only prod; fi
printf 'grm-dashboard: http://127.0.0.1:%s (loopback only; stop with Ctrl-C)\n' "$port"
exec mix phx.server
