# Copy to config.env; this is trusted Bash, sourced by every command.
# Precedence: exported GRM_* environment > this file > built-in defaults.
# Arrays cannot be exported: configure GRM_RUNNERS here.

# Downloaded, manually registered runner directories, each containing run.sh.
GRM_RUNNERS_DIR="$HOME/runners"
# name owner/repository weighted-units [registration-labels-for-reference]
# Labels are informational; set them when registering each runner.
GRM_RUNNERS=(
  "repo-a org/repo-a 3 self-hosted,linux,emulator"
  "repo-b org/repo-b 1 self-hosted,linux"
)

# All gates on this host must use the same local state directory and lock.
GRM_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/github-runner-manager"
GRM_SLOTS_CAPACITY=6
GRM_SLOTS_MAX_WAIT=2700  # Seconds; warn and admit on timeout, recording overcommit.
GRM_SLOTS_POLL=1        # Seconds; fractional values accepted.

GRM_DEVICE_LOCK="$GRM_STATE_DIR/device.lock"
GRM_DEVICE_LOCK_TIMEOUT=3600 # Seconds; lock timeout fails with exit 75.
GRM_DEVICE_LOCK_GRACE=5     # Seconds before killing a cancelled child.
GRM_DEVICE_LOCK_PARK=1       # 0 disables returning slots while waiting.
# GRM_SLOTS_HOLDER is an optional live PID for use outside runner jobs.
# Normally the wrapper finds its Runner.Worker ancestor automatically.

GRM_MAX_LOAD=$(getconf _NPROCESSORS_ONLN) # Strict upper bound on 1-minute load.
GRM_MIN_MEM_MB=3072                     # MemAvailable, in MiB (labelled MB).
GRM_LOAD_TIMEOUT=1800                  # Seconds; default action is warn/proceed.

GRM_WATCHDOG_MIN_AGE=600   # Process age, not time holding the lock.
GRM_WATCHDOG_KILL=0        # Report-only by default; 1 permits allow-listed TERM.
# Default allow-list is empty; kill mode kills nothing until configured.
# GRM_WATCHDOG_KILL_ALLOW="adb" # Space-separated exact Linux comm values.

GRM_EVENTS_MAX=500          # Event log lines kept for the status views; 0 disables.

GRM_UNIT_PREFIX="grm-runner-"
GRM_SYSTEMD_USER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
GRM_SYSTEMCTL="systemctl --user" # Command and whitespace-separated arguments.
# No shell evaluation; executable paths here must not contain whitespace.

# Install writes GRM_JOB_UNITS and GRM_CONFIG plus both hook paths to each
# runner's .env. Do not set one shared GRM_JOB_UNITS for differently sized jobs.
